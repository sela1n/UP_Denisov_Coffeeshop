<Window x:Class="UP_Denisov_Coffeeshop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сеть кофеен" Height="720" Width="1200" MinHeight="650" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource AppFont}" FontSize="14"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource HeaderBrush}">
            <DockPanel LastChildFill="True">
                <Button x:Name="BtnBack" DockPanel.Dock="Left" Content="← Назад"
                        ToolTip="Вернуться на предыдущую страницу" Click="BtnBack_Click"/>
                <Button x:Name="BtnExit" DockPanel.Dock="Right" Content="Выход"
                        ToolTip="Закрыть приложение" Click="BtnExit_Click"/>
                <Button x:Name="BtnTheme" DockPanel.Dock="Right" Content="Сменить тему"
                        ToolTip="Переключить оформление приложения" Click="BtnTheme_Click"/>
                <TextBlock x:Name="TbPageTitle" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource HeaderTextBrush}"/>
            </DockPanel>
        </Border>

        <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>

        <Border Grid.Row="2" Background="{DynamicResource HeaderBrush}">
            <Grid Margin="12,0">
                <TextBlock Text="Система управления сетью кофеен" VerticalAlignment="Center"
                           Foreground="{DynamicResource HeaderTextBrush}"/>
                <TextBlock x:Name="DateTimeNow" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{DynamicResource HeaderTextBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
