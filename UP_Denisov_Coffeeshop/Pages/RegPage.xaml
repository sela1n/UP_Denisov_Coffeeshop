<Page x:Class="UP_Denisov_Coffeeshop.Pages.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:h="clr-namespace:UP_Denisov_Coffeeshop.Helpers"
      Title="Регистрация">
    <Border Width="560" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24"
            CornerRadius="8" BorderThickness="1"
            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushMain}">
        <StackPanel>
            <TextBlock Text="Регистрация нового пользователя" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,12"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Content="Логин" Grid.Row="0"/>
                <TextBox x:Name="TbLogin" Grid.Row="0" Grid.Column="1" MaxLength="30"
                         h:Placeholder.Text="Латиница, цифры, «_»" ToolTip="От 3 до 30 символов"/>

                <Label Content="ФИО" Grid.Row="1"/>
                <TextBox x:Name="TbFio" Grid.Row="1" Grid.Column="1" MaxLength="150"
                         h:Placeholder.Text="Иванов Иван Иванович" ToolTip="Фамилия, имя, отчество кириллицей"/>

                <Label Content="Пароль" Grid.Row="2"/>
                <PasswordBox x:Name="PbFirst" Grid.Row="2" Grid.Column="1" MaxLength="50"
                             h:Placeholder.Text="Не менее 6 символов, есть цифра"
                             ToolTip="Латинские буквы и цифры, минимум 6 символов, хотя бы одна цифра"/>

                <Label Content="Повтор пароля" Grid.Row="3"/>
                <PasswordBox x:Name="PbSecond" Grid.Row="3" Grid.Column="1" MaxLength="50"
                             h:Placeholder.Text="Повторите пароль" ToolTip="Пароли должны совпадать"/>

                <Label Content="Роль" Grid.Row="4"/>
                <ComboBox x:Name="CbRole" Grid.Row="4" Grid.Column="1" ToolTip="Выберите роль пользователя"/>
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                <Button x:Name="BtnRegister" Content="Зарегистрироваться" IsDefault="True"
                        ToolTip="Создать учётную запись" Click="BtnRegister_Click"/>
                <Button x:Name="BtnClear" Content="Очистить" ToolTip="Очистить все поля" Click="BtnClear_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Page>
