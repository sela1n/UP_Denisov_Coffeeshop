<Page x:Class="UP_Denisov_Coffeeshop.Pages.PaymentTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:h="clr-namespace:UP_Denisov_Coffeeshop.Helpers"
      Title="Администратор: продажи">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel Margin="8,8,8,0">
            <TextBox x:Name="TbSearch" Width="280" h:Placeholder.Text="Поиск по названию позиции"
                     ToolTip="Введите часть названия позиции" TextChanged="TbSearch_TextChanged"/>
            <ComboBox x:Name="CbCategory" Width="220" ToolTip="Фильтр по категории"
                      SelectionChanged="CbCategory_SelectionChanged"/>
        </WrapPanel>

        <DataGrid x:Name="DataGridPayment" Grid.Row="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="100"/>
                <DataGridTextColumn Header="Сотрудник" Binding="{Binding User.FIO}" Width="220"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category.Name}" Width="110"/>
                <DataGridTextColumn Header="Позиция" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Num}" Width="80"/>
                <DataGridTextColumn Header="Цена, руб." Binding="{Binding Price, StringFormat=N2}" Width="100"/>
                <DataGridTextColumn Header="Сумма, руб." Binding="{Binding Total, StringFormat=N2}" Width="110"/>
                <DataGridTemplateColumn Header="Действие" Width="190" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Редактировать" Margin="2" ToolTip="Редактировать запись"
                                    Click="ButtonEdit_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
            <Button x:Name="BtnAdd" Content="Добавить" ToolTip="Добавить продажу" Click="BtnAdd_Click"/>
            <Button x:Name="BtnDelete" Content="Удалить" Style="{StaticResource DangerButton}"
                    ToolTip="Удалить выделенные продажи" Click="BtnDelete_Click"/>
        </StackPanel>
    </Grid>
</Page>
