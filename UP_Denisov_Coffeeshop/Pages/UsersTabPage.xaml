<Page x:Class="UP_Denisov_Coffeeshop.Pages.UsersTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:h="clr-namespace:UP_Denisov_Coffeeshop.Helpers"
      Title="Администратор: пользователи">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel Margin="8,8,8,0">
            <TextBox x:Name="TbSearch" Width="280" h:Placeholder.Text="Поиск по ФИО или логину"
                     ToolTip="Введите часть ФИО или логина" TextChanged="Filter_Changed"/>
            <ComboBox x:Name="CbRole" Width="170" SelectedIndex="0" ToolTip="Фильтр по роли"
                      SelectionChanged="Filter_SelectionChanged">
                <ComboBoxItem Content="Все роли"/>
                <ComboBoxItem Content="Admin"/>
                <ComboBoxItem Content="User"/>
            </ComboBox>
        </WrapPanel>

        <DataGrid x:Name="DataGridUser" Grid.Row="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="60"/>
                <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="160"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="100"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FIO}" Width="*"/>
                <DataGridTextColumn Header="Фото" Binding="{Binding Photo}" Width="200"/>
                <DataGridTemplateColumn Header="Действие" Width="190" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Редактировать" Margin="2" ToolTip="Редактировать запись"
                                    Click="ButtonEdit_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
            <Button x:Name="BtnAdd" Content="Добавить" ToolTip="Добавить пользователя" Click="BtnAdd_Click"/>
            <Button x:Name="BtnDelete" Content="Удалить" Style="{StaticResource DangerButton}"
                    ToolTip="Удалить выделенные записи (вместе с их продажами)" Click="BtnDelete_Click"/>
        </StackPanel>
    </Grid>
</Page>
