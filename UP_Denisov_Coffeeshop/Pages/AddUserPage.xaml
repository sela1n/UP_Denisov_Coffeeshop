<Page x:Class="UP_Denisov_Coffeeshop.Pages.AddUserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:h="clr-namespace:UP_Denisov_Coffeeshop.Helpers"
      Title="Пользователь">
    <Border Width="640" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24"
            CornerRadius="8" BorderThickness="1"
            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushMain}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Content="Логин" Grid.Row="0"/>
                <TextBox x:Name="TbLogin" Grid.Row="0" Grid.Column="1" MaxLength="30"
                         h:Placeholder.Text="Латиница, цифры, «_»" ToolTip="От 3 до 30 символов"/>

                <Label Content="Роль" Grid.Row="1"/>
                <ComboBox x:Name="CbRole" Grid.Row="1" Grid.Column="1" ToolTip="Роль определяет доступные страницы"/>

                <Label Content="ФИО" Grid.Row="2"/>
                <TextBox x:Name="TbFio" Grid.Row="2" Grid.Column="1" MaxLength="150"
                         h:Placeholder.Text="Иванов Иван Иванович" ToolTip="Фамилия, имя, отчество кириллицей"/>

                <Label Content="Пароль" Grid.Row="3"/>
                <PasswordBox x:Name="PbPassword" Grid.Row="3" Grid.Column="1" MaxLength="50"
                             ToolTip="Латиница и цифры, минимум 6 символов, хотя бы одна цифра"/>

                <Label Content="Фото" Grid.Row="4"/>
                <DockPanel Grid.Row="4" Grid.Column="1">
                    <Button x:Name="BtnBrowse" DockPanel.Dock="Right" Content="Обзор…"
                            ToolTip="Выбрать файл с фотографией" Click="BtnBrowse_Click"/>
                    <TextBox x:Name="TbPhoto" MaxLength="255" h:Placeholder.Text="Необязательно"
                             ToolTip="Путь к фото: png, jpg или bmp"/>
                </DockPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                <Button x:Name="BtnSave" Content="Сохранить" ToolTip="Сохранить данные" Click="BtnSave_Click"/>
                <Button x:Name="BtnClear" Content="Очистить" ToolTip="Очистить поля" Click="BtnClear_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Page>
