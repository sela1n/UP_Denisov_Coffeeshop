<Page x:Class="UP_Denisov_Coffeeshop.Pages.AddPaymentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:h="clr-namespace:UP_Denisov_Coffeeshop.Helpers"
      Title="Продажа">
    <Border Width="640" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24"
            CornerRadius="8" BorderThickness="1"
            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushMain}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Content="Позиция" Grid.Row="0"/>
                <TextBox x:Name="TbName" Grid.Row="0" Grid.Column="1" MaxLength="100"
                         h:Placeholder.Text="Например: Капучино 300 мл" ToolTip="Название позиции или напитка"/>

                <Label Content="Категория" Grid.Row="1"/>
                <ComboBox x:Name="CbCategory" Grid.Row="1" Grid.Column="1" DisplayMemberPath="Name"
                          ToolTip="Категория позиции меню"/>

                <Label Content="Сотрудник" Grid.Row="2"/>
                <ComboBox x:Name="CbUser" Grid.Row="2" Grid.Column="1" DisplayMemberPath="FIO"
                          ToolTip="Кто оформил продажу"/>

                <Label Content="Дата" Grid.Row="3"/>
                <DatePicker x:Name="DpDate" Grid.Row="3" Grid.Column="1" ToolTip="Дата продажи"/>

                <Label Content="Количество" Grid.Row="4"/>
                <TextBox x:Name="TbNum" Grid.Row="4" Grid.Column="1" MaxLength="3"
                         h:Placeholder.Text="От 1 до 100" ToolTip="Целое число от 1 до 100"/>

                <Label Content="Цена, руб." Grid.Row="5"/>
                <TextBox x:Name="TbPrice" Grid.Row="5" Grid.Column="1" MaxLength="8"
                         h:Placeholder.Text="От 0,01 до 10000" ToolTip="Цена за единицу, не более 10000"/>
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                <Button x:Name="BtnSave" Content="Сохранить" ToolTip="Сохранить данные" Click="BtnSave_Click"/>
                <Button x:Name="BtnClear" Content="Очистить" ToolTip="Очистить поля" Click="BtnClear_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Page>
