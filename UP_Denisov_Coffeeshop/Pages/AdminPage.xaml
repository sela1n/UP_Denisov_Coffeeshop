<Page x:Class="UP_Denisov_Coffeeshop.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Панель администратора">
    <Border Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24"
            CornerRadius="8" BorderThickness="1"
            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushMain}">
        <StackPanel>
            <TextBlock Text="Управление данными" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,12"/>
            <UniformGrid Columns="2">
                <Button x:Name="BtnUsers" Content="Пользователи"
                        ToolTip="Таблица пользователей: добавление, правка, удаление" Click="BtnUsers_Click"/>
                <Button x:Name="BtnCategory" Content="Категории"
                        ToolTip="Таблица категорий меню" Click="BtnCategory_Click"/>
                <Button x:Name="BtnPayment" Content="Продажи"
                        ToolTip="Таблица продаж (платежей)" Click="BtnPayment_Click"/>
                <Button x:Name="BtnDiagram" Content="Диаграммы и отчёты"
                        ToolTip="Диаграмма продаж и экспорт в Word / Excel" Click="BtnDiagram_Click"/>
                <Button x:Name="BtnUserView" Content="Сотрудники"
                        ToolTip="Карточки сотрудников (вид обычного пользователя)" Click="BtnUserView_Click"/>
            </UniformGrid>
        </StackPanel>
    </Border>
</Page>
