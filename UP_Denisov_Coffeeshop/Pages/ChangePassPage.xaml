<Page x:Class="UP_Denisov_Coffeeshop.Pages.ChangePassPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:h="clr-namespace:UP_Denisov_Coffeeshop.Helpers"
      Title="Смена пароля">
    <Border Width="560" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24"
            CornerRadius="8" BorderThickness="1"
            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushMain}">
        <StackPanel>
            <TextBlock Text="Смена пароля" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,12"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Content="Логин" Grid.Row="0"/>
                <TextBox x:Name="TbLogin" Grid.Row="0" Grid.Column="1" MaxLength="30"
                         h:Placeholder.Text="Ваш логин" ToolTip="Логин пользователя"/>

                <Label Content="Текущий пароль" Grid.Row="1"/>
                <PasswordBox x:Name="PbOld" Grid.Row="1" Grid.Column="1" MaxLength="50"
                             h:Placeholder.Text="Текущий пароль" ToolTip="Пароль, который действует сейчас"/>

                <Label Content="Новый пароль" Grid.Row="2"/>
                <PasswordBox x:Name="PbNew" Grid.Row="2" Grid.Column="1" MaxLength="50"
                             h:Placeholder.Text="Не менее 6 символов, есть цифра"
                             ToolTip="Латинские буквы и цифры, минимум 6 символов, хотя бы одна цифра"/>

                <Label Content="Повтор нового" Grid.Row="3"/>
                <PasswordBox x:Name="PbConfirm" Grid.Row="3" Grid.Column="1" MaxLength="50"
                             h:Placeholder.Text="Повторите новый пароль" ToolTip="Пароли должны совпадать"/>
            </Grid>
            <Button x:Name="BtnSave" Content="Изменить пароль" IsDefault="True" Margin="0,12,0,0"
                    ToolTip="Сохранить новый пароль" Click="BtnSave_Click"/>
        </StackPanel>
    </Border>
</Page>
