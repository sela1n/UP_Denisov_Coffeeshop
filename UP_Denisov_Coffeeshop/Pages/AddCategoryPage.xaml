<Page x:Class="UP_Denisov_Coffeeshop.Pages.AddCategoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:h="clr-namespace:UP_Denisov_Coffeeshop.Helpers"
      Title="Категория">
    <Border Width="560" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24"
            CornerRadius="8" BorderThickness="1"
            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushMain}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Название"/>
                <TextBox x:Name="TbName" Grid.Column="1" MaxLength="100"
                         h:Placeholder.Text="Например: Кофе" ToolTip="Название категории меню"/>
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                <Button x:Name="BtnSave" Content="Сохранить" IsDefault="True" ToolTip="Сохранить данные" Click="BtnSave_Click"/>
                <Button x:Name="BtnClear" Content="Очистить" ToolTip="Очистить поле" Click="BtnClear_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Page>
